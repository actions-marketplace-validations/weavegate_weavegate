<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The same Boot parent as sdk/java, so the application and the Java
       integration share one pinned Spring, HikariCP and Connector/J baseline. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>io.github.weavegate.fixture</groupId>
  <artifactId>spring-matching</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>weavegate spring-matching fixture</name>
  <description>Synthetic instrumented Spring Boot assignment workflow for paired replay evidence.</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The Java integration coordinate. Until a release is published, build
         it from sdk/java at the same revision with `./mvnw install`. -->
    <weavegate.version>0.0.0-SNAPSHOT</weavegate.version>
  </properties>

  <dependencies>
    <!-- The weavegate Java integration; it brings the JDBC starter and Connector/J. -->
    <dependency>
      <groupId>io.github.weavegate</groupId>
      <artifactId>weavegate-spring</artifactId>
      <version>${weavegate.version}</version>
    </dependency>
  </dependencies>

  <build>
    <!-- .weavegate/config.yaml names this file. -->
    <finalName>spring-matching</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.github.weavegate.fixture.springmatching.InstrumentedMain</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
