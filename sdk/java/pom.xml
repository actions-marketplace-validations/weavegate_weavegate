<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The Boot parent pins Spring Framework, Jackson, HikariCP, Connector/J,
       JUnit, Testcontainers and plugin versions as one supported baseline. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>io.github.weavegate</groupId>
  <artifactId>weavegate-spring</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>weavegate Spring instrumentation</name>
  <description>Opt-in Spring Boot peer for the weavegate external SUT protocol v1.</description>
  <url>https://github.com/weavegate/weavegate</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>weavegate</id>
      <name>weavegate maintainers</name>
      <url>https://github.com/weavegate</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/weavegate/weavegate.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/weavegate/weavegate.git</developerConnection>
    <url>https://github.com/weavegate/weavegate</url>
  </scm>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Repetition count for the evidence-producing tests; CI records 20. -->
    <weavegate.repetitions>1</weavegate.repetitions>
    <weavegate.evidence>${project.build.directory}/weavegate-evidence/java.log</weavegate.evidence>
  </properties>

  <dependencies>
    <!-- Spring JDBC transaction manager, DataSourceUtils and HikariCP pool. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Strict JSON codec for the framed control protocol. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- MySQL Connector/J: the only supported fixture driver. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Records per-execution observer evidence through a launcher listener. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real MySQL 8.4 for pinned transaction, lease and driver behavior. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>supported-baseline</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.16]</version>
                </requireMavenVersion>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <runOrder>alphabetical</runOrder>
          <trimStackTrace>false</trimStackTrace>
          <systemPropertyVariables>
            <weavegate.repetitions>${weavegate.repetitions}</weavegate.repetitions>
            <weavegate.evidence>${weavegate.evidence}</weavegate.evidence>
            <weavegate.repository>${project.basedir}/../..</weavegate.repository>
            <weavegate.maven>${maven.version}</weavegate.maven>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- Ordinary development and acceptance builds never run the release packaging plugins. -->
  <profiles>
    <profile>
      <id>central-release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
            <configuration>
              <bestPractices>true</bestPractices>
              <ascDirectory>${project.build.directory}</ascDirectory>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
